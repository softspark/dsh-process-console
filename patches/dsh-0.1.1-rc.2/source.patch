+import { describe, expect, it } from 'vitest'
+import { fileURLToPath } from 'node:url'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { SubagentStreamItem } from '@deepseek-ai/dsh-subagent'
+import { spawnSubprocess } from '@deepseek-ai/dsh-subprocess-local/src/spawn.ts'
+import { DEFAULT_DISPOSE_EOF_GRACE_MS, DEFAULT_DISPOSE_GRACE_MS, mapAcpUpdate, startAcpRun, type AcpRunSpec } from '../src/run.ts'
+
+const update = (value: unknown): Parameters<typeof mapAcpUpdate>[0] => value as Parameters<typeof mapAcpUpdate>[0]
+const mockServer = fileURLToPath(new URL('./mock-acp-server.ts', import.meta.url))
+
+describe('mapAcpUpdate', () => {
+  it('maps chunks, tool calls, settled updates and plans', () => {
+    expect(mapAcpUpdate(update({ sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: 'Hi' } })))
+      .toEqual({ kind: 'assistant', text: 'Hi' })
+    expect(mapAcpUpdate(update({ sessionUpdate: 'agent_thought_chunk', content: { type: 'text', text: 'hm' } })))
+      .toEqual({ kind: 'thought', text: 'hm' })
+    expect(mapAcpUpdate(update({ sessionUpdate: 'user_message_chunk', content: { type: 'image', data: '' } })))
+      .toEqual({ kind: 'other', text: '' })
+    expect(mapAcpUpdate(update({
+      sessionUpdate: 'tool_call', toolCallId: 't1', title: 'Read file', kind: 'read', status: 'in_progress', rawInput: { path: 'a' },
+    }))).toEqual({
+      kind: 'tool-call', name: 'Read file', callId: 't1', text: '{\n  "path": "a"\n}', meta: { status: 'in_progress', toolKind: 'read' },
+    })
+    expect(mapAcpUpdate(update({ sessionUpdate: 'tool_call_update', toolCallId: 't1', status: 'in_progress' }))).toBeUndefined()
+    expect(mapAcpUpdate(update({
+      sessionUpdate: 'tool_call_update', toolCallId: 't1', status: 'completed', title: 'Read file',
+      content: [
+        { type: 'content', content: { type: 'text', text: 'line 1' } },
+        { type: 'diff', path: 'a', oldText: 'x', newText: 'y' },
+        { type: 'terminal', terminalId: 'term-1' },
+      ],
+    }))).toEqual({
+      kind: 'tool-result', callId: 't1', text: 'line 1\n--- a\nx\n+++ a\ny\n[terminal term-1]', isError: false, name: 'Read file', meta: { status: 'completed' },
+    })
+    expect(mapAcpUpdate(update({ sessionUpdate: 'tool_call_update', toolCallId: 't2', status: 'failed', rawOutput: { code: 1 } })))
+      .toEqual({ kind: 'tool-result', callId: 't2', text: '{\n  "code": 1\n}', isError: true, meta: { status: 'failed' } })
+    expect(mapAcpUpdate(update({
+      sessionUpdate: 'plan', entries: [{ content: 'read', status: 'completed', priority: 'high' }, { content: 'write', status: 'pending', priority: 'low' }],
+    }))).toEqual({ kind: 'plan', text: '- [completed] read\n- [pending] write' })
+    expect(mapAcpUpdate(update({ sessionUpdate: 'usage_update' }))).toBeUndefined()
+    expect(mapAcpUpdate(update({ sessionUpdate: 'current_mode_update', currentModeId: 'x' }))).toBeUndefined()
+  })
+})
+
+describe('startAcpRun stream', () => {
+  it('delivers the child text to the stream sink with the run id, merged into one step', async () => {
+    const seen: Array<{ item: SubagentStreamItem; childId: string }> = []
+    const parent = { id: 'parent', session: { header: { cwd: process.cwd() } } } as unknown as Agent
+    const spec: AcpRunSpec = {
+      command: process.execPath,
+      args: [mockServer],
+      cwd: process.cwd(),
+      permission: 'reject',
+      env: { MOCK_TEXT: 'streamed answer' },
+      disposeEofGraceMs: DEFAULT_DISPOSE_EOF_GRACE_MS,
+      disposeGraceMs: DEFAULT_DISPOSE_GRACE_MS,
+      spawn: spawnSpec => spawnSubprocess(spawnSpec),
+      onStream: (item, childId) => { seen.push({ item, childId: String(childId) }) },
+    }
+
+    const run = await startAcpRun({ prompt: [{ type: 'text', text: 'p' }], parent, signal: new AbortController().signal }, spec)
+    const result = await run.result
+    await run.dispose()
+
+    expect(result.stopReason).toBe('completed')
+    expect(seen.map(entry => entry.item)).toEqual([{ kind: 'assistant', text: 'streamed answer' }])
+    expect(seen.every(entry => entry.childId === String(run.id))).toBe(true)
+  })
+})
