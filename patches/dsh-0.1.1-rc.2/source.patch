+import { describe, expect, it, vi } from 'vitest'
+import type { SDKMessage } from '@anthropic-ai/claude-agent-sdk'
+import { consumeClaudeQuery, mapClaudeMessage } from '../src/run.ts'
+
+const message = (value: unknown): SDKMessage => value as SDKMessage
+
+async function* stream(messages: readonly SDKMessage[]): AsyncGenerator<SDKMessage, void> {
+  for (const item of messages) yield item
+}
+
+describe('mapClaudeMessage', () => {
