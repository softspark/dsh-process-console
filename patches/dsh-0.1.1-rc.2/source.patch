@@ -0,0 +1,45 @@
+import type { ClaudeCodePermissionMode } from './run.ts'
+
+/**
+ * Resolve the native Claude Code mode for one delegated run.
+ *
+ * Only the explicit DSH Full pair can elevate a configured safe fallback.
+ * Partial, malformed, and less-permissive session state keeps the deployment
+ * fallback.
+ *
+ * @param fallback - Provider mode configured by the deployment.
+ * @param inheritSessionPermissions - Whether this provider accepts DSH Full.
+ * @param events - Parent session log in chronological order.
+ * @returns The native mode for this run.
+ */
+export function resolveClaudePermissionMode(
+  fallback: ClaudeCodePermissionMode,
+  inheritSessionPermissions: boolean,
+  events: readonly unknown[],
+): ClaudeCodePermissionMode {
+  if (!inheritSessionPermissions) return fallback
+
+  let sandbox: unknown
+  let approval: unknown
+  for (let index = events.length - 1; index >= 0; index -= 1) {
+    const event = events[index]
+    if (!isRecord(event)) continue
+    const data = event['data']
+    if (!isRecord(data)) continue
+    if (sandbox === undefined && event['type'] === 'sandbox/mode') {
+      sandbox = data['mode']
+    }
+    if (approval === undefined && event['type'] === 'approval/policy') {
+      approval = data['policy']
+    }
+    if (sandbox !== undefined && approval !== undefined) break
+  }
+
+  return sandbox === 'danger-full-access' && approval === 'never'
+    ? 'bypassPermissions'
+    : fallback
+}
+
+function isRecord(value: unknown): value is Readonly<Record<string, unknown>> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
