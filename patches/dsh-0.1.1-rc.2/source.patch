+import { describe, expect, it } from 'vitest'
+import { Session, SessionId } from '../src/index.ts'
+
+describe('Session.append ignorable option', () => {
+  it('stamps the envelope marker on a log-only event and keeps it off by default', () => {
+    const session = Session.create(SessionId('ignorable'))
+
+    const marked = session.append('plugin/stream' as never, { step: 1 } as never, { ignorable: true })
+    const plain = session.append('turn/start', { turn: 1 })
+
+    expect(marked.ignorable).toBe(true)
+    expect(marked.data).toEqual({ step: 1 })
+    expect(Object.hasOwn(plain, 'ignorable')).toBe(false)
+    expect(session.events.map(event => event.type)).toEqual(['plugin/stream', 'turn/start'])
+  })
+
+  it('refuses to mark a surface event ignorable', () => {
+    const session = Session.create(SessionId('ignorable-surface'))
+    session.append('turn/start', { turn: 1 })
+
+    expect(() => session.append(
+      'user/message',
+      { role: 'user', content: [{ type: 'text', text: 'hi' }], source: 'human' } as never,
+      { surfaceOp: { op: 'append' }, ignorable: true } as never,
+    )).toThrow(/cannot be both a surface event and ignorable/u)
+  })
+})
diff --git a/packages/subagent/subagent/src/stream.ts b/packages/subagent/subagent/src/stream.ts
new file mode 100644
index 0000000..6e0033e
--- /dev/null
+++ b/packages/subagent/subagent/src/stream.ts
@@ -0,0 +1,214 @@
+/**
+ * The `subagent/stream` session event: one observed step of an out-of-process
+ * child, appended to the DELEGATING PARENT's log by the provider that owns the
+ * child's stream.
+ *
+ * Out-of-process one-shot children (Claude Code, ACP agents) have no session
+ * of their own in the parent's corpus; without this event the parent log keeps
+ * only the delegation call and its final answer. The event is log-only and
+ * `ignorable`: it never enters model history, `deriveMessages()` ignores it,
+ * and a harness that does not know the type skips it instead of refusing the
+ * log. Every text field is bounded, so a verbose child cannot inflate the
+ * parent log without limit.
+ * @module @deepseek-ai/dsh-subagent/stream
+ */
+
+import type { JsonValue, SessionId } from '@deepseek-ai/dsh-session'
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /**
+     * One observed step of an out-of-process subagent child, appended to the
+     * delegating parent's log. Log-only and ignorable: presentation only.
+     */
+    'subagent/stream': SubagentStreamData
+  }
+}
+
+/** What kind of step the child took. */
+export type SubagentStreamItemKind =
+  | 'system'
+  | 'assistant'
+  | 'thought'
+  | 'tool-call'
+  | 'tool-result'
+  | 'result'
+  | 'plan'
+  | 'other'
+
+/** One step, in provider-neutral vocabulary. */
+export interface SubagentStreamItem {
+  readonly kind: SubagentStreamItemKind
+  /** The step's text: assistant prose, tool arguments, tool output, a diagnostic. */
+  readonly text?: string
+  /** Tool name for tool steps. */
+  readonly name?: string
+  /** Child-local call id pairing a tool call with its result. */
+  readonly callId?: string
+  readonly isError?: boolean
+  /** Small provider-specific facts (model, status, cost). Bounded by the sink. */
+  readonly meta?: JsonValue
+}
+
+/** The event data. */
+export interface SubagentStreamData {
+  /** The run's child id, the same value the provider returns as `SubagentRun.id`. */
+  readonly childId: SessionId
+  /** The provider registry name that owns the child. */
+  readonly provider: string
+  /** Zero-based position within this child's stream. */
+  readonly index: number
+  readonly item: SubagentStreamItem
+  /** Present when a text field was cut to {@link MAX_SUBAGENT_STREAM_TEXT_BYTES}. */
+  readonly truncated?: true
+}
+
+/** Receives one child step; the provider calls it from its stream loop. */
+export type SubagentStreamSink = (item: SubagentStreamItem) => void
+
+/** Upper bound of one item's `text` in UTF-8 bytes. */
+export const MAX_SUBAGENT_STREAM_TEXT_BYTES = 16_384
+/** Upper bound of one item's serialized `meta` in UTF-8 bytes; larger metadata is dropped. */
+export const MAX_SUBAGENT_STREAM_META_BYTES = 2_048
+const TRUNCATION_SUFFIX = '\n[stream text truncated]'
+
+const utf8Encoder = new TextEncoder()
+const utf8Decoder = new TextDecoder()
+
+/**
+ * Cut `text` to the byte bound on a UTF-8 character boundary.
+ * @param text - the candidate text.
+ * @returns the text that fits plus whether anything was cut.
+ */
+export function limitSubagentStreamText(text: string): { readonly text: string; readonly truncated: boolean } {
+  const bytes = utf8Encoder.encode(text)
+  if (bytes.byteLength <= MAX_SUBAGENT_STREAM_TEXT_BYTES) return { text, truncated: false }
+  let prefixBytes = MAX_SUBAGENT_STREAM_TEXT_BYTES - utf8Encoder.encode(TRUNCATION_SUFFIX).byteLength
+  while (((bytes[prefixBytes] as number) & 0b1100_0000) === 0b1000_0000) prefixBytes -= 1
+  return { text: utf8Decoder.decode(bytes.subarray(0, prefixBytes)) + TRUNCATION_SUFFIX, truncated: true }
+}
+
+/** The one method the sink needs from the parent session. */
+interface AppendableLog {
+  append(type: 'subagent/stream', data: SubagentStreamData, opts: { ignorable: true }): unknown
+}
+
+function isAppendable(log: unknown): log is AppendableLog {
+  return typeof log === 'object' && log !== null
+    && typeof (log as { append?: unknown }).append === 'function'
+}
+
+/**
+ * Build the sink that appends one child's steps to the parent log.
+ *
+ * A parent without an appendable session (a test stub, an unusual host) gets
+ * a no-op sink: the stream is a courtesy, never a precondition of the run.
+ * An append failure is reported once through `onError` and then silences the
+ * sink for the rest of the run, so a broken log cannot turn every child step
+ * into a thrown error inside the provider's stream loop.
+ * @param parentSession - the delegating parent's session (`request.parent.session`).
+ * @param childId - the run's child id.
+ * @param provider - the provider registry name.
+ * @param onError - receives the first append failure.
+ * @returns the sink.
+ */
+export function createSubagentStreamSink(
+  parentSession: unknown,
+  childId: SessionId,
+  provider: string,
+  onError?: (error: Error) => void,
+): SubagentStreamSink {
+  if (!isAppendable(parentSession)) return () => {}
+  let index = 0
+  let broken = false
+  return (item) => {
+    if (broken) return
+    const bounded = boundItem(item)
+    try {
+      parentSession.append('subagent/stream', {
+        childId,
+        provider,
+        index: index++,
+        item: bounded.item,
+        ...(bounded.truncated ? { truncated: true as const } : {}),
+      }, { ignorable: true })
+    } catch (error: unknown) {
+      broken = true
+      onError?.(error instanceof Error ? error : new Error(String(error)))
+    }
+  }
+}
+
+function boundItem(item: SubagentStreamItem): { readonly item: SubagentStreamItem; readonly truncated: boolean } {
+  let truncated = false
+  const out: { -readonly [K in keyof SubagentStreamItem]: SubagentStreamItem[K] } = { kind: item.kind }
+  if (item.text !== undefined) {
+    const limited = limitSubagentStreamText(item.text)
+    out.text = limited.text
+    truncated = limited.truncated
+  }
+  if (item.name !== undefined) out.name = item.name.slice(0, 256)
+  if (item.callId !== undefined) out.callId = item.callId.slice(0, 256)
+  if (item.isError !== undefined) out.isError = item.isError
+  if (item.meta !== undefined) {
+    let serialized: string | undefined
+    try {
+      serialized = JSON.stringify(item.meta)
+    } catch {
+      serialized = undefined
+    }
+    if (serialized !== undefined && utf8Encoder.encode(serialized).byteLength <= MAX_SUBAGENT_STREAM_META_BYTES) {
+      out.meta = item.meta
+    } else {
+      truncated = true
+    }
+  }
+  return { item: out, truncated }
+}
+
+/** Default flush threshold of {@link coalesceSubagentStream}. */
+export const SUBAGENT_STREAM_COALESCE_CHARS = 1_024
+
+/**
+ * Merge consecutive text fragments of the same kind into one item.
+ *
+ * Chunked protocols (ACP) deliver assistant and thought text a few characters
+ * at a time; one log event per fragment would flood the parent log. Fragments
+ * accumulate until the kind changes, a non-text item arrives, the buffer
+ * reaches `maxChars`, or `flush()` is called at the end of the run.
+ * @param sink - the downstream sink.
+ * @param maxChars - flush threshold in UTF-16 code units.
+ * @returns the coalescing front plus its explicit flush.
+ */
+export function coalesceSubagentStream(
+  sink: SubagentStreamSink,
+  maxChars = SUBAGENT_STREAM_COALESCE_CHARS,
+): { push: SubagentStreamSink; flush: () => void } {
+  let pendingKind: SubagentStreamItemKind | undefined
+  let pending: string[] = []
+  const flush = (): void => {
+    if (pendingKind === undefined) return
+    const kind = pendingKind
+    const text = pending.join('')
+    pendingKind = undefined
+    pending = []
+    sink({ kind, text })
+  }
+  return {
+    push: (item) => {
+      const fragment = (item.kind === 'assistant' || item.kind === 'thought')
+        && item.text !== undefined && item.name === undefined && item.callId === undefined
+        && item.meta === undefined && item.isError === undefined
+      if (!fragment) {
+        flush()
+        sink(item)
+        return
+      }
+      if (pendingKind !== undefined && pendingKind !== item.kind) flush()
+      pendingKind = item.kind
+      pending.push(item.text as string)
+      if (pending.reduce((total, part) => total + part.length, 0) >= maxChars) flush()
+    },
+    flush,
+  }
+}
