+import { describe, expect, it, vi } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import {
+  coalesceSubagentStream,
+  createSubagentStreamSink,
+  limitSubagentStreamText,
+  MAX_SUBAGENT_STREAM_META_BYTES,
+  MAX_SUBAGENT_STREAM_TEXT_BYTES,
+  type SubagentStreamData,
+  type SubagentStreamItem,
+} from '../src/stream.ts'
+
+const childId = SessionId('child-1')
+
+function recordingLog() {
+  const appended: Array<{ type: string; data: SubagentStreamData; opts: unknown }> = []
+  return {
+    appended,
+    session: {
+      append: (type: string, data: SubagentStreamData, opts: unknown) => {
+        appended.push({ type, data, opts })
+        return { type, data }
+      },
+    },
+  }
+}
+
+describe('createSubagentStreamSink', () => {
+  it('appends ignorable subagent/stream events with a per-child index', () => {
+    const log = recordingLog()
+    const sink = createSubagentStreamSink(log.session, childId, 'claude-code')
+
+    sink({ kind: 'assistant', text: 'hello' })
+    sink({ kind: 'tool-call', name: 'Bash', callId: 'c1', text: '{"command":"ls"}', meta: { status: 'pending' } })
+
+    expect(log.appended.map(entry => entry.type)).toEqual(['subagent/stream', 'subagent/stream'])
+    expect(log.appended.every(entry => JSON.stringify(entry.opts) === '{"ignorable":true}')).toBe(true)
+    expect(log.appended[0]?.data).toEqual({
+      childId, provider: 'claude-code', index: 0, item: { kind: 'assistant', text: 'hello' },
+    })
+    expect(log.appended[1]?.data).toEqual({
+      childId, provider: 'claude-code', index: 1,
+      item: { kind: 'tool-call', name: 'Bash', callId: 'c1', text: '{"command":"ls"}', meta: { status: 'pending' } },
+    })
+  })
+
+  it('is a no-op for a parent without an appendable session', () => {
+    expect(() => createSubagentStreamSink({ header: { cwd: '/w' } }, childId, 'acp')({ kind: 'assistant', text: 'x' })).not.toThrow()
+    expect(() => createSubagentStreamSink(undefined, childId, 'acp')({ kind: 'assistant', text: 'x' })).not.toThrow()
+  })
+
+  it('bounds text and metadata and marks the event truncated', () => {
+    const log = recordingLog()
+    const sink = createSubagentStreamSink(log.session, childId, 'acp')
+    const long = 'é'.repeat(MAX_SUBAGENT_STREAM_TEXT_BYTES)
+
+    sink({ kind: 'tool-result', text: long, meta: { blob: 'x'.repeat(MAX_SUBAGENT_STREAM_META_BYTES + 1) } })
+
+    const data = log.appended[0]?.data
+    expect(data?.truncated).toBe(true)
+    expect(data?.item.meta).toBeUndefined()
+    const text = data?.item.text ?? ''
+    expect(new TextEncoder().encode(text).byteLength).toBeLessThanOrEqual(MAX_SUBAGENT_STREAM_TEXT_BYTES)
+    expect(text.endsWith('[stream text truncated]')).toBe(true)
+    // The cut lands on a character boundary: the decoded prefix is whole `é`s.
+    expect(text.slice(0, text.indexOf('\n'))).toMatch(/^é+$/u)
+  })
+
+  it('reports the first append failure once and then stays silent', () => {
+    const onError = vi.fn()
+    const append = vi.fn(() => { throw new Error('closed') })
+    const sink = createSubagentStreamSink({ append }, childId, 'acp', onError)
+
+    sink({ kind: 'assistant', text: 'a' })
+    sink({ kind: 'assistant', text: 'b' })
+
+    expect(append).toHaveBeenCalledTimes(1)
+    expect(onError).toHaveBeenCalledTimes(1)
+    expect(onError.mock.calls[0]?.[0]).toBeInstanceOf(Error)
+  })
+})
+
+describe('limitSubagentStreamText', () => {
+  it('returns short text unchanged', () => {
+    expect(limitSubagentStreamText('short')).toEqual({ text: 'short', truncated: false })
+  })
+})
+
+describe('coalesceSubagentStream', () => {
+  it('merges text fragments of one kind and flushes on kind change, non-text items, size and flush()', () => {
+    const out: SubagentStreamItem[] = []
+    const stream = coalesceSubagentStream(item => { out.push(item) }, 6)
+
+    stream.push({ kind: 'assistant', text: 'He' })
+    stream.push({ kind: 'assistant', text: 'llo' })
+    stream.push({ kind: 'thought', text: 'hm' })
+    stream.push({ kind: 'tool-call', name: 't', callId: '1', text: '{}' })
+    stream.push({ kind: 'assistant', text: 'abc' })
+    stream.push({ kind: 'assistant', text: 'def' })
+    stream.push({ kind: 'assistant', text: 'tail' })
+    stream.flush()
+    stream.flush()
+
+    expect(out).toEqual([
+      { kind: 'assistant', text: 'Hello' },
+      { kind: 'thought', text: 'hm' },
+      { kind: 'tool-call', name: 't', callId: '1', text: '{}' },
+      { kind: 'assistant', text: 'abcdef' },
+      { kind: 'assistant', text: 'tail' },
+    ])
+  })
+})
