+import { describe, expect, it } from 'vitest'
+
+import { resolveClaudePermissionMode } from '../src/session-permissions.ts'
+
+function events(
+  ...items: ReadonlyArray<{ readonly type: string; readonly data: unknown }>
+): readonly unknown[] {
+  return items
+}
+
+describe('resolveClaudePermissionMode', () => {
+  it('keeps the configured safe fallback when inheritance is disabled', () => {
+    expect(resolveClaudePermissionMode('dontAsk', false, events(
+      { type: 'sandbox/mode', data: { mode: 'danger-full-access' } },
+      { type: 'approval/policy', data: { policy: 'never' } },
+    ))).toBe('dontAsk')
+  })
+
+  it('maps the explicit DSH Full pair to bypassPermissions', () => {
+    expect(resolveClaudePermissionMode('dontAsk', true, events(
+      { type: 'sandbox/mode', data: { mode: 'danger-full-access' } },
+      { type: 'approval/policy', data: { policy: 'never' } },
+    ))).toBe('bypassPermissions')
+  })
+
+  it('does not elevate partial or interactive permission state', () => {
+    expect(resolveClaudePermissionMode('dontAsk', true, events(
+      { type: 'sandbox/mode', data: { mode: 'danger-full-access' } },
+    ))).toBe('dontAsk')
+    expect(resolveClaudePermissionMode('dontAsk', true, events(
+      { type: 'sandbox/mode', data: { mode: 'danger-full-access' } },
+      { type: 'approval/policy', data: { policy: 'ask' } },
+    ))).toBe('dontAsk')
+  })
+
+  it('uses the latest durable permission values', () => {
+    expect(resolveClaudePermissionMode('dontAsk', true, events(
+      { type: 'sandbox/mode', data: { mode: 'danger-full-access' } },
+      { type: 'approval/policy', data: { policy: 'never' } },
+      { type: 'sandbox/mode', data: { mode: 'workspace-write' } },
+    ))).toBe('dontAsk')
+  })
+
+  it('ignores malformed unrelated events', () => {
+    expect(resolveClaudePermissionMode('acceptEdits', true, events(
+      { type: 'sandbox/mode', data: null },
+      { type: 'approval/policy', data: { policy: 'allow' } },
+    ))).toBe('acceptEdits')
+  })
+})
